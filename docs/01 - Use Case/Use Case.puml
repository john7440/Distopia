@startuml
left to right direction

Actor Visiteur
Actor Utilisateur
Actor Admin

Utilisateur -|> Visiteur
Admin -|> Utilisateur

rectangle "Distopia" {

usecase "Gérer le site" as A1

usecase "Se connecter" as AUTH
usecase "Créer un compte" as UC5

usecase "Consulter les films" as UC1
usecase "Consulter les cinémas" as UC2
usecase "Consulter les details d'un film" as UC3
usecase "Consulter les séances d'un film" as UC4

usecase "Réserver une ou plusieurs places" as UC6

usecase "Consulter son historique de réservations" as UC7

note bottom of A1
    Inclut :
    - CRUD Villes
    - CRUD Cinémas
    - CRUD Films (soft delete)
    - CRUD Séances
    - Importer films depuis TMDB
end note

Visiteur -- UC1
Visiteur -- UC2
Visiteur -- UC3
Visiteur -- UC4
Visiteur -- UC5

Utilisateur -- UC6

Admin -- A1

UC6 ..> AUTH : <<include>>
A1 ..> AUTH : <<include>>

UC7 .up.> UC6 : <<extend>>
}
@enduml