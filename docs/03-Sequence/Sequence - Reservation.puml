@startuml
title Movie Reservation Sequence

actor "Authenticated User" as User
participant "ReservationController" as Controller
participant "ReservationService" as Service
participant "ReservationRepository" as ReservationRepo
participant "SeanceRepository" as SeanceRepo

activate User
User -> Controller : POST /reserve
activate Controller

Controller -> Service : existsByUserAndSeance(userId, seanceId)
activate Service

Service -> ReservationRepo : findByUserIdAndSeanceId(userId, seanceId)
activate ReservationRepo
ReservationRepo --> Service : Optional<Reservation>
deactivate ReservationRepo

Service --> Controller : alreadyBooked
deactivate Service

alt already booked and not confirmed
    Controller --> User : redirect and ask confirmation
else new or confirmed reservation
    Controller -> Service : createReservation(seanceId, userId, quantity)
    activate Service

    Service -> SeanceRepo : findByIdForUpdate(seanceId)
    activate SeanceRepo
    SeanceRepo --> Service : locked seance
    deactivate SeanceRepo

    alt not enough seats
        Service --> Controller : NoSeatsAvailableException
        deactivate Service
        Controller --> User : redirect with error
    else enough seats
        Service -> ReservationRepo : save(reservation)
        activate ReservationRepo
        ReservationRepo --> Service : saved reservation
        deactivate ReservationRepo

        Service --> Controller : reservation created
        deactivate Service

        Controller --> User : redirect with success
        deactivate Controller
    end
end
@enduml